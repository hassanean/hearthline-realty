# Google Sheet ID for CRM integration
# Share your sheet with "Anyone with the link can view", then paste the ID here.
# Sheet ID is the long string in the URL:
#   https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
#
# Required columns (row 1 = headers):
#   id | address | neighborhood | city | state | zip | price | beds | baths
#   sqft | type | yearBuilt | lotSize | hoaFee | propertyTax | openHouse
#   description | features | imageUrl | imageUrls | status
#   walkScore | transitScore | bikeScore
#
# "features" = pipe-separated list  e.g. "Hardwood floors|Updated kitchen|Deck"
# "imageUrls" = comma-separated Unsplash or absolute URLs for the gallery
# "status"    = active | pending | sold
# "type"      = House | Condo | Townhouse | Multi-Family

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Listings
